<%- include('partials/header', { title }) %>
<main>
  <form method="POST" action="/items" id="add-form">
    <h2>New Item</h2>
    <div>
      <label for="item-name">Item: </label>
      <input 
        type="text" 
        id="item-name" 
        name="name" 
        value="<%= formData.name || '' %>" 
        autocomplete="off"
      >
    </div>
    <div>
      <label for="item-type">Type: </label>
      <select id="type" name="type">
        <option value="">--- Select Type ---</option>
        <% weaponTypes.forEach((weaponType) => { %>
          <option 
            value="<%= weaponType %>" 
            <%= (locals.item && item.type === weaponType) ? 'selected' : '' %>
          >
            <%= weaponType %>
          </option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="item-stock">Stock: </label>
      <input type="number" id="item-stock" name="stock" value="<%= formData.stock || '' %>">
    </div>
    <div>
      <label for="item-cost">Cost: </label>
      <input type="number" id="item-cost" name="cost" value="<%= formData.cost || '' %>">
    </div>
    <p class="error-display">
      <% if (errors.length > 0) { %>
        <%= errors[0].msg %>
      <% } else { %>
        &nbsp;
      <% } %>
    </p>
    <span class="add-btn-row">
      <a class="back-to-shop-link" href="/items">Back</a>
      <button class="add-btn" type="submit">Add</button>
    </span>
  </form>
</main>
<%- include('partials/footer') %>
