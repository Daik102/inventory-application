<%- include('partials/header', { title }) %>
<main>
  <form method="POST" action="/items/<%= item.id %>/edit" id="edit-form">
    <h2>Edit Item</h2>
    <div>
      <label for="item-name">Item: </label>
      <input 
        type="text" 
        id="item-name" 
        name="name" 
        value="<%= item.name %>" 
        autocomplete="off"
      >
    </div>
    <div>
      <label for="item-type">Type: </label>
      <select id="type" name="type">
        <option value="">-- Select Weapon Type --</option>
        <% weaponTypes.forEach((weaponType) => { %>
          <option 
            value="<%= weaponType %>" 
            <%= (locals.item && item.type === weaponType) ? 'selected' : '' %>
          >
            <%= weaponType %>
          </option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="item-stock">Stock: </label>
      <input type="number" id="item-stock" name="stock" value="<%= item.stock %>">
    </div>
    <div>
      <label for="item-cost">Cost: </label>
      <input type="number" id="item-cost" name="cost" value="<%= item.cost %>">
    </div>
    <p class="error-display">
      <% if (errors.length > 0) { %>
        <%= errors[0].msg %>
      <% } else { %>
        &nbsp;
      <% } %>
    </p>
    <span class="edit-btn-row">
      <a class="back-to-shop-link" href="/items/<%= item.id %>">Back</a>
      <button class="edit-btn" type="submit">Edit</button>
    </span>
  </form>
</main>
<%- include('partials/footer') %>
