<%- include('partials/header', { title }) %>
<main class="items-main">
  <form action="/items" method="GET" id="filter-form">
    <input 
      type="text" 
      id="search-input"
      name="search" 
      placeholder="Search item..." 
      autocomplete="off"
    />
    <select id="type-filter" name="type">
      <option value="">All Types</option>
      <% weaponTypes.forEach((weaponType) => { %>
        <option value="<%= weaponType %>"><%= weaponType %></option>
      <% }) %>
    </select>
    <button type="button" class="clear-btn">Clear</button>
  </form>
  <a class="add-item-link" href="/items/new">Add Item</a>
  <table class="item-table">
    <thead>
      <tr>
        <th class="sortable" data-col="0" data-type="text" tabindex="0">Item<span class="sort-icon"></span></th>
        <th class="sortable" data-col="1" data-type="text" tabindex="0">Type<span class="sort-icon"></span></th>
        <th class="sortable num" data-col="2" data-type="num" tabindex="0">Stock<span class="sort-icon"></span></th>
        <th class="sortable num" data-col="3" data-type="num" tabindex="0">Cost<span class="sort-icon"></span></th>
      </tr>
    </thead>
    <tbody id="items-tbody">
      <% if (items.length === 0) { %>
        <tr>
          <td colspan="4">No items in stock. Add some gear!</td>
        </tr>
      <% } else { %>
        <% items.forEach((item) => { %>
          <tr class="item-row" data-href="/items/<%= item.id %>" tabindex="0">
            <td><%= item.name %></td>
            <td><%= item.type %></td>
            <td class="num"><%= item.stock %></td>
            <td class="num"><%= item.cost %>G</td>
          </tr>
        <% }) %>
        <tr id="no-results-row" style="display: none;">
          <td colspan="4">No matching gear found!</td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <a class="back-home-link" href="/">Back</a>
</main>
<%- include('partials/footer') %>

<script>
  const searchInput = document.getElementById('search-input');
  const typeFilter = document.getElementById('type-filter');
  const clearBtn = document.querySelector('.clear-btn');
  const tbody = document.getElementById('items-tbody');
  const itemRows = Array.from(document.querySelectorAll('.item-row'));
  const noResultsRow = document.getElementById('no-results-row');
  const headers = document.querySelectorAll('th.sortable');

  let currentSortCol = null;
  let currentSortOrder = 'asc';

  // 1. Clickable Rows -> Navigate to /items/:id
  itemRows.forEach((row) => {
    row.addEventListener('click', () => {
      window.location.href = row.dataset.href;
    });

    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        window.location.href = row.dataset.href;
      }
    });
  });

  // 2. Live Search & Type Filter
  function filterRows() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const selectedType = typeFilter.value;
    let visibleCount = 0;

    searchTerm !== '' || selectedType !== '' ? clearBtn.classList.add('visible') : clearBtn.classList.remove('visible');

    itemRows.forEach((row) => {
      const itemName = row.children[0].textContent.toLowerCase();
      const itemType = row.children[1].textContent.trim();

      const matchesSearch = itemName.includes(searchTerm);
      const matchesType = selectedType === '' || itemType === selectedType;

      if (matchesSearch && matchesType) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (noResultsRow) {
      noResultsRow.style.display = visibleCount === 0 ? '' : 'none';
    }
  }

  searchInput.addEventListener('input', filterRows);
  typeFilter.addEventListener('change', filterRows);
  
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    typeFilter.value = '';
    filterRows();
  });

  // 3. Instant Column Sorting
  function sortColumns(header) {
    const colIndex = parseInt(header.dataset.col, 10);
    const dataType = header.dataset.type;

    // Toggle asc / desc
    if (currentSortCol === colIndex) {
      currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
    } else {
      currentSortCol = colIndex;
      currentSortOrder = 'asc';
    }

    // Update ▲ / ▼ indicators
    headers.forEach((h) => (h.querySelector('.sort-icon').textContent = ''));
    header.querySelector('.sort-icon').textContent = currentSortOrder === 'asc' ? '▲' : '▼';

    // Sort the array of <tr> elements
    const sortedRows = [...itemRows].sort((a, b) => {
      const valA = a.children[colIndex].textContent.trim();
      const valB = b.children[colIndex].textContent.trim();

      if (dataType === 'num') {
        // Strip " G" from Cost and parse as integers
        const numA = parseInt(valA.replace(/[^0-9-]/g, ''), 10);
        const numB = parseInt(valB.replace(/[^0-9-]/g, ''), 10);
        return currentSortOrder === 'asc' ? numA - numB : numB - numA;
      } else {
        return currentSortOrder === 'asc'
          ? valA.localeCompare(valB)
          : valB.localeCompare(valA);
      }
    });

    // Re-append sorted rows into <tbody> (keeping #no-results-row at the bottom)
    sortedRows.forEach((row) => tbody.appendChild(row));

    if (noResultsRow) {
      tbody.appendChild(noResultsRow);
    }
  }
  
  headers.forEach((header) => {
    header.addEventListener('click', () => {
      sortColumns(header);
    });

    header.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        sortColumns(header);
      }
    });
  });
</script>
