<%- include('partials/header', { title }) %>
<main class="items-main">
  <form action="/items" method="GET" id="filter-form">
    <input 
      type="text" 
      id="search-input"
      name="search" 
      placeholder="Search item..." 
      autocomplete="off"
    />
    <select id="type-filter" name="type">
      <option value="">All Types</option>
      <% weaponTypes.forEach((weaponType) => { %>
        <option value="<%= weaponType %>"><%= weaponType %></option>
      <% }) %>
    </select>
    <button type="button" class="clear-btn">Clear</button>
  </form>
  <a class="add-item-link" href="/items/new">Add Item</a>
  <table class="item-table">
    <thead>
      <tr>
        <th>
          <a href="/items?sort=name&order=<%= sort === 'name' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= encodeURIComponent(search) %>&type=<%= encodeURIComponent(type || '') %>">
            Item <%= sort === 'name' ? (order === 'asc' ? '▲' : '▼') : '' %>
          </a>
        </th>
        <th>
          <a href="/items?sort=type&order=<%= sort === 'type' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= encodeURIComponent(search) %>&type=<%= encodeURIComponent(type || '') %>">
            Type <%= sort === 'type' ? (order === 'asc' ? '▲' : '▼') : '' %>
          </a>
        </th>
        <th class="num">
          <a href="/items?sort=stock&order=<%= sort === 'stock' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= encodeURIComponent(search) %>&type=<%= encodeURIComponent(type || '') %>">
            Stock <%= sort === 'stock' ? (order === 'asc' ? '▲' : '▼') : '' %>
          </a>
        </th>
        <th class="num">
          <a href="/items?sort=cost&order=<%= sort === 'cost' && order === 'asc' ? 'desc' : 'asc' %>&search=<%= encodeURIComponent(search) %>&type=<%= encodeURIComponent(type || '') %>">
            Cost <%= sort === 'cost' ? (order === 'asc' ? '▲' : '▼') : '' %>
          </a>
        </th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (items.length === 0) { %>
        <tr>
          <td colspan="5">No items in stock. Add some gear!</td>
        </tr>
      <% } else { %>
        <% items.forEach((item) => { %>
          <tr class="item-row">
            <td><%= item.name %></td>
            <td><%= item.type %></td>
            <td class="num"><%= item.stock %></td>
            <td class="num"><%= item.cost %> G</td>
            <td>
              <div class="action-buttons">
                <a href="/items/<%= item.id %>/edit">E</a>
                <a href="/items/<%= item.id %>/delete">X</a>
              </div>
            </td>
          </tr>
        <% }) %>

        <!-- Hidden by default; revealed by JS when 0 rows match -->
        <tr id="no-results-row" style="display: none;">
          <td colspan="5">No matching gear found!</td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <a class="back-home-link" href="/">Back</a>
</main>
<%- include('partials/footer') %>

<script>
  const filterForm = document.getElementById('filter-form');
  const searchInput = document.getElementById('search-input');
  const typeFilter = document.getElementById('type-filter');
  const clearBtn = document.querySelector('.clear-btn');
  const itemRows = document.querySelectorAll('.item-row');
  const noResultsRow = document.getElementById('no-results-row');

  function filterRows() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const selectedType = typeFilter.value;
    let visibleCount = 0;

    // Show Clear button only when a filter is active
    const isFiltered = searchTerm !== '' || selectedType !== '';
    isFiltered ? clearBtn.classList.add('visible') : clearBtn.classList.remove('visible');

    itemRows.forEach((row) => {
      const itemName = row.children[0].textContent.toLowerCase();
      const itemType = row.children[1].textContent.trim();

      const matchesSearch = itemName.includes(searchTerm);
      const matchesType = selectedType === '' || itemType === selectedType;

      if (matchesSearch && matchesType) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    // Toggle the "No matching gear found!" row
    if (noResultsRow) {
      noResultsRow.style.display = visibleCount === 0 ? '' : 'none';
    }
  }

  filterForm.addEventListener('submit', (e) => e.preventDefault());
  searchInput.addEventListener('input', filterRows);
  typeFilter.addEventListener('change', filterRows);

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    typeFilter.value = '';
    filterRows();
  });
</script>
